{
    "rewrites": [
        {
            "source": "/prompt-packs",
            "destination": "/prompt-packs/index.html"
        },
        {
            "source": "/ai-tools",
            "destination": "/ai-tools/index.html"
        },
        {
            "source": "/learning-roadmaps",
            "destination": "/learning-roadmaps/index.html"
        },
        {
            "source": "/news",
            "destination": "/news/index.html"
        },
        {
            "source": "/privacy",
            "destination": "/privacy/index.html"
        },
        {
            "source": "/terms",
            "destination": "/terms/index.html"
        },
        {
            "source": "/as",
            "destination": "/as/index.html"
        },
        {
            "source": "/as/",
            "destination": "/as/index.html"
        },
        {
            "source": "/as/prompt-packs",
            "destination": "/as/prompt-packs/index.html"
        },
        {
            "source": "/as/ai-tools",
            "destination": "/as/ai-tools/index.html"
        },
        {
            "source": "/as/learning-roadmaps",
            "destination": "/as/learning-roadmaps/index.html"
        },
        {
            "source": "/as/news",
            "destination": "/as/news/index.html"
        },
        {
            "source": "/as/privacy",
            "destination": "/as/privacy/index.html"
        },
        {
            "source": "/as/terms",
            "destination": "/as/terms/index.html"
        },
        {
            "source": "/(.*)",
            "destination": "/index.html"
        }
    ],
    "headers": [
        {
            "source": "/sitemap.xml",
            "headers": [
                {
                    "key": "Content-Type",
                    "value": "application/xml; charset=utf-8"
                }
            ]
        },
        {
            "source": "/(.*)",
            "headers": [
                {
                    "key": "X-Content-Type-Options",
                    "value": "nosniff"
                },
                {
                    "key": "X-Frame-Options",
                    "value": "DENY"
                },
                {
                    "key": "X-XSS-Protection",
                    "value": "1; mode=block"
                },
                {
                    "key": "Referrer-Policy",
                    "value": "strict-origin-when-cross-origin"
                }
            ]
        },
        {
            "source": "/assets/(.*)",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=31536000, immutable"
                }
            ]
        }
    ]
}
